# Formspree — Créer un compte sur https://formspree.io et remplacer par votre ID de formulaire
# Exemple : VITE_FORMSPREE_ID=xpwzygkd
VITE_FORMSPREE_ID=your_formspree_id_here

# Cal.com — Créer un compte gratuit sur https://cal.com, connecter Google Calendar,
# créer les Event Types et indiquer ici les liens (username/event-slug)

# Visite Conseil 2h à domicile (payante, 320 €)
# Exemple : VITE_CALCOM_LINK=maisonmikasa/visite-conseil-2h
VITE_CALCOM_LINK=your_calcom_username/your_event_slug

# Appel découverte 20 min (gratuit, sans engagement)
# Si vide, la page /rendez-vous n'affiche que la visite conseil
# Exemple : VITE_CALCOM_LINK_APPEL=maisonmikasa/appel-decouverte
VITE_CALCOM_LINK_APPEL=your_calcom_username/your_event_slug
